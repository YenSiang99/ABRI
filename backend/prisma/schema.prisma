// Prisma schema for ABRI — modeled on the frontend's mock store layer
// (frontend/src/lib/store/*.js), which already encodes the real entities
// and state machine. See backend/README.md for what's intentionally
// different from the mock (password hashing, no denormalized counts, etc).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// id is a human-readable slug (e.g. "meridian-accounting"), not a cuid —
// matches the frontend's existing routing contract (/business/:id,
// /m/:businessId) exactly, so the app layer must slugify on create.
model Business {
  id                String   @id
  name              String
  category          String
  location          String
  // L0 Unclaimed · L1 Claimed · L2 SSM-Verified · L3 Identity-Verified
  // · L4 Transaction-Trusted
  //
  // A LEVEL, not a tier, and the distinction is the product's one naming
  // rule: a TIER is bought, a LEVEL is earned or claimed. This column is
  // the thing money cannot move — ABRI-feature-checklist.md §6 lists
  // "verification cannot be bought" as non-negotiable — so it can never be
  // called a tier. membershipTier below is the axis that can be, and it is
  // the only one.
  //
  // Stays L0 until some account's claim is actually APPROVED — multiple
  // accounts can hold pending claims against an L0 business at once (see
  // Account.claimStatus below); the level only moves once one of them wins.
  //
  // Renamed from `tier`, values T0-T4, in
  // migrations/20260831120000_rename_axes_tier_level. The union lives in
  // lib/verificationLevels.js — this schema has no Prisma enums, so that
  // module is the only thing constraining this column, and a value outside
  // it fails every Set.has gate silently: no vouching, no ask posting, no
  // badge icon, and nothing in the logs.
  verificationLevel String   @default("L0")
  description       String?
  services          String[] @default([])
  ssm               String?
  // The same number with every separator removed and upper-cased, and the
  // only thing GET /businesses/lookup matches on.
  //
  // A SECOND COLUMN RATHER THAN NORMALIZING `ssm` IN PLACE, because the two
  // have different readers. An admin ruling on a submission needs the number
  // as it appears on the document; a lookup needs one canonical key. One
  // registration number is written at least three ways — "202301234567
  // (1234567-A)" on a letterhead, "2023 0123 4567" by hand, "1234567-A" in
  // the pre-2016 format — and Prisma cannot strip punctuation from a column
  // inside a `where`, so the normalization has to happen on write or not at
  // all.
  //
  // Derived, and therefore capable of drifting from `ssm` — the one risk this
  // schema otherwise refuses. It is contained by there being exactly two
  // writers (POST /businesses/me/ssm and findOrCreateClaimTarget), both of
  // which go through normalizeSsm in lib/businessLookup.js. A third writer
  // that sets `ssm` alone is a business that cannot be found by its own
  // number, so set them together or not at all.
  ssmNormalized     String?
  // Canonical email domain, set at seed/import time — used to auto-approve
  // a claim when the claimant's email matches it. Never claimant-editable.
  domain            String?

  // Contact fields. Which of the two groups a column is in IS what it means,
  // and the split is enforced in exactly one place — omitContactFields in
  // lib/accountView.js, reached only through publicBusinessView:
  //
  //   GATED  — phone/whatsapp/email. Never cross the wire to a third party
  //            unless the OWNER is on plus or above AND the viewer is logged
  //            in. The rule lives in lib/contactVisibility.js; the plan half
  //            of it is `contactDetails` in lib/entitlements.js.
  //   PUBLIC — website/address/openingHours. Shown on every plan to
  //            everyone, anonymous visitors included. These are the half of
  //            "full business page" not worth withholding: a business nobody
  //            can find the door of doesn't upgrade, it leaves.
  //
  // Adding a PRIVATE column here means adding it to omitContactFields too,
  // or it leaks by default. Adding a PUBLIC one means doing nothing — that
  // asymmetry is the deliberate trade omitBillingFields already makes, and
  // its comment explains why.
  //
  // `email` is a PUBLISHED "contact us" address and nothing else. It is not
  // Account.email (the login credential — unique, proves identity) and it is
  // not `domain` above (claim verification, never claimant-editable, feeds
  // matchesBusinessDomain). This one is free text the owner types: not
  // unique, not verified, and it must never be read by anything that
  // authenticates or auto-approves a claim.
  phone        String?
  whatsapp     String?
  email        String?
  website      String?
  address      String?
  // One free-text string, deliberately not Json and not String[] — nothing
  // queries or computes on opening hours (no "open now", no filter, no
  // booking), and the real answers include "By appointment only", which a
  // day-map can't hold without a free-text escape hatch anyway.
  openingHours String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // "free" | "plus" | "pro" | "enterprise" — the membership TIER, and the
  // third axis on a business after the verification LEVEL above and the
  // vouch LEVEL, which is derived and has no column at all.
  //
  // The names are the rule, and the rule is one sentence: a TIER is bought,
  // a LEVEL is earned or claimed. This column is the only thing in the
  // product anyone can buy. If a fourth axis ever appears, its name decides
  // itself — money moves it, or it doesn't.
  // Determines the vouch-giving cap (see lib/vouchCap.js), which is
  // currently the only behaviour it gates. Deliberately never surfaced as
  // a profile badge — it must not read as a third kind of TRUST signal
  // sitting beside the other two, so the only place it appears is the
  // member's own sidebar, styled as billing metadata.
  //
  // Renamed from "basic"/"premium"/"enterprise" in
  // migrations/20260817120000_rename_membership_plans, and from
  // `membershipPlan` in 20260831120000_rename_axes_tier_level. Any change to
  // this union has to move VOUCH_CAP_BY_MEMBERSHIP_TIER in lib/vouchCap.js
  // in the same commit — a value here with no entry there silently removes
  // the cap — and MEMBERSHIP_TIER_RANK in lib/entitlements.js, which is
  // where the tier half of the contact gate (`contactDetails`) is ranked.
  // lib/contactVisibility.js consumes that; it is the other reader.
  membershipTier String @default("free")

  // Null until the business first lands on a tier (set at claim approval).
  // membershipTierExpiresAt stays null for tiers that don't lapse; nothing reads it
  // yet, but renewal is the next thing to touch this row and a nullable
  // column costs nothing to add now versus a second migration later.
  membershipTierStartedAt DateTime?
  membershipTierExpiresAt DateTime?

  // The founding-100 programme, split out of membershipTier so it survives
  // every later tier change. It used to be encoded AS the plan (founding
  // members were assigned "premium"), which meant the first upgrade,
  // downgrade or expiry silently erased the fact that they were founding
  // members at all. Earned once, never revoked — see businessClaim.js.
  isFoundingMember Boolean @default(false)

  // Many, not one: while unclaimed/contested, several accounts can hold
  // competing pending claims on the same business at once (see Account
  // .claimStatus). Once one is approved, the rest are deleted, so in
  // steady state this is back to one — but the relation has to allow many
  // to support both that transient dispute window AND (later) multiple
  // legitimate team members under one business.
  accounts             Account[]
  vouchesReceived      Vouch[]              @relation("VouchTarget")
  vouchesGiven         Vouch[]              @relation("VouchSource")
  connectionsAsA       Connection[]         @relation("ConnectionA")
  connectionsAsB       Connection[]         @relation("ConnectionB")
  connectionsRequested Connection[]         @relation("ConnectionRequester")
  following            Follow[]             @relation("FollowFrom")
  followers            Follow[]             @relation("FollowTo")
  deferredConnections  DeferredConnection[]
  flagsRaised          VouchFlag[]          @relation("FlagRaisedBy")
  flagsAgainst         VouchFlag[]          @relation("FlagAgainst")
  activityEvents       ActivityEvent[]      @relation("ActivityEventOwner")
  activityAsActor      ActivityEvent[]      @relation("ActivityEventActor")
  vouchRevisions       VouchRevision[]      @relation("VouchRevisionAuthor")
  vouchActionsAsActor  VouchAction[]        @relation("VouchActionActor")

  // Asks. Note recommendationsReceived is the ONE relation here that can
  // point at a T0 listing — see AskAnswer.recommendedBusinessId for why the
  // board departs from "unclaimed businesses are refused everything".
  asksPosted              Ask[]       @relation("AskAuthor")
  askAnswersGiven         AskAnswer[] @relation("AskAnswerAuthor")
  recommendationsReceived AskAnswer[] @relation("AskAnswerRecommended")
  askFlagsRaised          AskFlag[]   @relation("AskFlagRaisedBy")
  askFlagsAgainst         AskFlag[]   @relation("AskFlagAgainst")

  // The network feed. Two relations for the same reason ActivityEvent needs
  // two: an event is ABOUT one business and was DONE BY another, and the feed
  // renders both ends as separate links.
  networkEvents        NetworkEvent[] @relation("NetworkEventSubject")
  networkEventsAsActor NetworkEvent[] @relation("NetworkEventActor")

  // The two Pro tools on the check-a-business screen. Both are one-way and
  // keyed to the WATCHER/CHECKER, never to the business being looked at —
  // see each model for why that direction is load-bearing.
  watching    BusinessWatch[] @relation("WatchWatcher")
  watchedBy   BusinessWatch[] @relation("WatchTarget")
  checksMade  BusinessCheck[] @relation("CheckBy")
  checksAbout BusinessCheck[] @relation("CheckTarget")

  // ProfileView is the DELIBERATE EXCEPTION to the paragraph above, and the
  // only relation here that is read from the target's side. See the model.
  profileViewsMade     ProfileView[] @relation("ProfileViewer")
  profileViewsReceived ProfileView[] @relation("ProfileViewTarget")

  // Both ends of every engagement this business is part of, plus the ones it
  // proposed. Three relations for the same reason Connection needs three: the
  // pair is stored ordered by id, so "which end am I" is not derivable and
  // "who proposed" is a separate fact again.
  engagementsA        Engagement[] @relation("EngagementA")
  engagementsB        Engagement[] @relation("EngagementB")
  engagementsProposed Engagement[] @relation("EngagementProposer")

  // Browse without being named. Off by default, and that default is the
  // feature working at all: a network where most members start invisible has
  // a viewers screen that says "someone" forever.
  //
  // NOT A PAID SETTING, and it must not become one. Selling privacy would
  // make the cheapest members the most exposed, in a product whose entire
  // pitch is trust.
  //
  // IT COSTS THE MEMBER THEIR OWN VIEWER LIST — routes/watches.js enforces
  // that, not this column. Without the reciprocity this is one-way
  // surveillance that anyone can switch on: see everyone who looked at you,
  // be seen by none of them. The trade is the only reason the setting is
  // defensible, so a change here that leaves /viewers readable while this is
  // true reintroduces exactly what it was added to prevent.
  privateBrowsing Boolean @default(false)

  // The first indexes this model has ever carried, added with the
  // check-a-business lookup (GET /businesses/lookup) that queries both.
  //
  // Both serve EQUALITY on a normalized value — a pasted registration number
  // or a bare hostname, cleaned up by lib/businessLookup.js before it reaches
  // Postgres. `ssmNormalized` is queried with both `contains` and `equals`
  // (against each token of the pasted string), so a btree earns its place
  // once the column is populated.
  //
  // Deliberately NO index for the name search, here or on the directory's.
  // Name is matched with `contains` + insensitive, i.e. ILIKE '%x%', which no
  // btree can serve — it would need a pg_trgm GIN index and a Postgres
  // extension. A sequential scan is the right answer well past the corridor's
  // firm count; the moment to revisit is a name search that has become slow,
  // not a table that has become large.
  @@index([ssmNormalized])
  @@index([domain])
}

model Account {
  id            String   @id @default(cuid())
  email         String   @unique
  phone         String
  name          String
  role          String
  // Real hash (bcrypt/argon2), never plaintext — the mock store keeps
  // plaintext passwords, which is fine for a localStorage demo and not fine
  // for a real database.
  passwordHash  String
  emailVerified Boolean  @default(false)
  phoneVerified Boolean  @default(false)
  // Grants access to /admin/* routes (see middleware/requireAdmin.js).
  // Replaces the old ADMIN_EMAILS env-var allowlist — flip this directly in
  // the DB (there's no admin UI for it yet) rather than editing env config.
  isAdmin       Boolean  @default(false)
  createdAt     DateTime @default(now())

  // Not unique — several accounts can point at the same business while
  // their claims are still pending/contested. A claim "wins" by reaching
  // claimStatus "approved"; every other account on that businessId then
  // gets deleted. (Bare /auth/register accounts have businessId null and
  // claimStatus null — this field only means something once a claim exists.)
  businessId         String?
  business           Business? @relation(fields: [businessId], references: [id])
  // null (not a claim) | "pending" | "approved"
  claimStatus        String?
  // null | "manual" | "domain-auto"
  verificationMethod String?

  deferredConnections DeferredConnection[]
  // Admin-only back-relations: the vouch interventions this account made and
  // the reports it ruled on. Empty for every non-admin account.
  vouchActionsAsAdmin VouchAction[]        @relation("VouchActionAdminActor")
  vouchFlagsResolved  VouchFlag[]          @relation("VouchFlagResolver")
  askFlagsResolved    AskFlag[]            @relation("AskFlagResolver")
}

// The vouch feature is three tables, and which one a piece of text lives in
// is the whole design:
//
//   Vouch          — the workflow header. Mutable. Current state only.
//   VouchRevision  — every version of the GIVER's testimonial. Insert-only.
//   VouchAction    — every state transition, including the RECEIVER's
//                    revert and cancel notes. Insert-only.
//
// The rule that makes the audit trail work: no table holds a text column
// that is ever UPDATEd. A revise inserts a revision, it does not overwrite
// one; a revert inserts an action, it does not overwrite one. The
// header points at the live revision rather than carrying a copy of its
// text, so there is exactly one place each piece of authored text exists
// and no way for the history to disagree with the current state.
//
// A vouch is receiver-gated before it counts as a trust signal — mirrors
// how LinkedIn recommendations need the recipient's approval before going
// live, rather than a bilateral edit negotiation. The receiver has four
// actions and each is one transition:
//   pending -> published (accept; counts toward vouchCount/vouchLevel)
//   pending -> cancelled (cancel, or 14 days pass untouched — see
//     lib/vouchExpiry.js for the lazy, no-cron expiry check)
//   pending -> reverted (revert: sent back to be edited, capped at
//     maxRevisions rounds, so the loop can't run forever)
//   pending|reverted -> under_review (flag: suspended, an admin's move)
// and the giver's revise closes the loop:
//   reverted -> pending (new revision; revisionCount += 1)
// under_review is the one status no business can leave. An admin picks one
// of three exits (see POST /admin/vouch-reviews/:id/decide):
//   under_review -> pending   (returned to the receiver; flag dismissed)
//   under_review -> reverted  (sent back to the giver to fix; flag upheld)
//   under_review -> cancelled (killed; flag upheld)
// cancelled rows are never deleted — a fresh POST /vouches on a cancelled
// pair resets this same row in place (see routes/vouches.js) rather than
// requiring a delete-then-recreate dance, so @@unique keeps meaning
// "exactly one row per pair, ever, reused across attempts."
model Vouch {
  id String @id @default(cuid())

  // "pending"      — the receiver's move
  // "reverted"     — sent back to the giver to edit; their move
  // "under_review" — flagged by the receiver; an admin's move, and the one
  //                  in-flight status the 14-day expiry doesn't touch
  // "published" / "cancelled" — terminal (closedAt set)
  // See the diagram at the top of src/routes/vouches.js.
  status String @default("pending")

  // Pointer to the live testimonial, not a copy of its text. The previous
  // shape kept a denormalized `testimonial` string here and that column is
  // exactly where history went to die — a revise overwrote it in place, so
  // "what did revision 1 actually say" became unanswerable. Reads that
  // want the current text join through this.
  currentRevisionId String?        @unique
  currentRevision   VouchRevision? @relation("CurrentRevision", fields: [currentRevisionId], references: [id])

  // Which submission cycle this row is on. Starts at 1 and increments
  // each time a cancelled row is resubmitted through POST /vouches. Child
  // rows carry the attempt they belong to, so a fresh attempt starts with
  // a clean slate instead of inheriting the previous attempt's change
  // requests — while the old rows stay as history rather than being
  // deleted. (An alternative shape would be one row per attempt with a
  // partial unique index on the active ones; this keeps the plain
  // @@unique below meaningful, which is what enforces the anti-spam rule.)
  attempt       Int @default(1)
  // Rounds used within the CURRENT attempt only (reset to 0 on resubmit).
  revisionCount Int @default(0)
  // Per-row rather than a global constant so a specific vouch can be given
  // more rounds later without a migration.
  maxRevisions  Int @default(2)

  // Bumped on every state transition — drives the 14-day lazy-expiry check.
  lastActionAt DateTime  @default(now())
  createdAt    DateTime  @default(now())
  // Set when the vouch reaches a terminal status. Distinguishes "settled"
  // from "in flight" without having to enumerate status values.
  closedAt     DateTime?

  fromBusinessId String
  fromBusiness   Business @relation("VouchSource", fields: [fromBusinessId], references: [id])

  toBusinessId String
  toBusiness   Business @relation("VouchTarget", fields: [toBusinessId], references: [id])

  revisions     VouchRevision[] @relation("VouchRevisions")
  actions       VouchAction[]
  flags         VouchFlag[]
  // Back-relation only. The feed points AT a vouch rather than copying its
  // text, so a revised or withdrawn testimonial is never stale in two places.
  networkEvents NetworkEvent[]

  // One vouch per (voucher, target) pair — the mock store didn't enforce
  // this, but letting the same business vouch for another unlimited times
  // undermines the signal. vouchCount/vouchLevel are intentionally NOT stored
  // here (unlike the mock's business.vouchCount) — derive them by counting
  // published rows in this relation at query time so they can never drift
  // out of sync.
  @@unique([fromBusinessId, toBusinessId])
  // GET /vouches/requests filters on exactly these two pairs.
  @@index([toBusinessId, status])
  @@index([fromBusinessId, status])
}

// Every version of the giver's testimonial, one row per submit or revise.
// Never updated, only inserted — that invariant is the entire reason this
// table exists, so nothing here should ever appear in an UPDATE.
model VouchRevision {
  id      String @id @default(cuid())
  vouchId String
  vouch   Vouch  @relation("VouchRevisions", fields: [vouchId], references: [id])
  attempt Int

  // 1 = the attempt's original submission, 2.. = successive revisions.
  // 1-based because it's shown to users ("Revision 2 of 3"), and an
  // off-by-one in a label is worse than one in an array index.
  revisionNumber Int
  comment        String

  // Always the giver — denormalized off vouch.fromBusinessId so a revision
  // is self-describing when read on its own (e.g. from an admin query).
  createdById String
  createdBy   Business @relation("VouchRevisionAuthor", fields: [createdById], references: [id])

  createdAt DateTime @default(now())

  actions   VouchAction[]
  flags     VouchFlag[]
  currentOf Vouch?        @relation("CurrentRevision")

  @@unique([vouchId, attempt, revisionNumber])
  @@index([vouchId])
}

// Append-only log of every state transition — the timeline UI reads this
// and nothing else. Distinct from ActivityEvent, which is a per-business
// notification feed keyed on businessId with no vouchId and therefore
// can't reconstruct a single vouch's history.
//
// `comment` is the RECEIVER's text (why they want changes, why they
// cancelled). It lives on the action rather than in its own table because
// it only ever exists as the payload of one specific transition — giving
// it a separate home meant a note could in principle outlive, or drift
// from, the action that produced it. The giver's text is never here; that
// belongs in VouchRevision, reachable via revisionId.
model VouchAction {
  id      String @id @default(cuid())
  vouchId String
  vouch   Vouch  @relation(fields: [vouchId], references: [id])
  attempt Int

  // Giver:    "submit" | "revise"
  // Receiver: "accept" | "revert" | "cancel" | "flag"
  // Admin:    "admin_return" | "admin_revert" | "admin_cancel"
  // System:   "expire"
  action String

  // Which testimonial version this action concerns: the one created (for
  // submit/revise) or the one being responded to (for revert, cancel,
  // accept). This is what answers "which testimonial was the second
  // revert about" — it pins the action to the exact text in front of
  // the actor at the time, rather than to whatever the vouch says now.
  revisionId String?
  revision   VouchRevision? @relation(fields: [revisionId], references: [id])

  // Null for "expire" and for every admin_* action — neither the system nor
  // an admin is a party to the vouch, and an admin reading the log has to be
  // able to tell a real cancel from a timeout or an intervention.
  actorId String?
  actor   Business? @relation("VouchActionActor", fields: [actorId], references: [id])

  // Set only on admin_* actions, where actorId is null: which admin made the
  // call. An Account rather than a Business because admins have no business
  // (see AppLayout.jsx's admin redirect), which is the whole reason actorId
  // can't carry them. Never serialized to the two businesses — they see that
  // "an admin" ruled, not who; see serializeAction in lib/vouchTurn.js.
  actorAccountId String?
  actorAccount   Account? @relation("VouchActionAdminActor", fields: [actorAccountId], references: [id])

  comment String?

  fromStatus String?
  toStatus   String

  createdAt DateTime @default(now())

  @@index([vouchId, createdAt])
}

// A report an admin is meant to read, raised by either side.
//
// The two directions are NOT symmetric, and the asymmetry is the point:
//   receiver -> giver ("abusive_content"/"other") suspends the live vouch
//     in "under_review", because the thing being reported is a testimonial
//     that hasn't been published yet and shouldn't proceed while in doubt;
//   giver -> receiver ("unfair_cancel") is tracking-only, because by then
//     the vouch is already terminal — there's nothing left to suspend, and
//     the report exists to surface a business that cancels in bad faith
//     repeatedly.
// See routes/admin.js for the review queue.
model VouchFlag {
  id      String @id @default(cuid())
  vouchId String
  vouch   Vouch  @relation(fields: [vouchId], references: [id])

  raisedByBusinessId String
  raisedByBusiness   Business @relation("FlagRaisedBy", fields: [raisedByBusinessId], references: [id])

  againstBusinessId String
  againstBusiness   Business @relation("FlagAgainst", fields: [againstBusinessId], references: [id])

  // Raised by the receiver: "abusive_content" | "other"
  // Raised by the giver:    "unfair_cancel"
  reason     String
  note       String?
  // The exact testimonial version that was flagged. Used to be a copied
  // `testimonialSnapshot` string, which existed only because the live text
  // could be overwritten out from under it — now that revisions are
  // immutable, pointing at one is strictly better: same guarantee, no
  // duplicated text to fall out of sync.
  revisionId String?
  revision   VouchRevision? @relation(fields: [revisionId], references: [id])

  status              String    @default("open") // "open" | "reviewed"
  // How it was judged, recorded separately from `status` because "an admin
  // looked at this" and "an admin agreed with it" are different facts and
  // only the second one is worth counting. This is the column a
  // repeat-offender signal reads: upheld flags against a business over time,
  // rather than raw flag volume, which anyone can inflate by complaining.
  // Null while status is "open".
  outcome             String? // "upheld" | "dismissed"
  resolvedAt          DateTime?
  resolvedByAccountId String?
  resolvedByAccount   Account?  @relation("VouchFlagResolver", fields: [resolvedByAccountId], references: [id])
  createdAt           DateTime  @default(now())

  @@index([vouchId])
}

// Powers the give-first reciprocity loop's notify step (Dashboard.jsx's
// "Recent activity") — businessId is whose feed this appears in,
// actorBusinessId is the other party. type values (see
// lib/activityEvents.js for the message-text map): "vouch_submitted"
// (-> receiver), "vouch_published" / "vouch_cancelled" / "vouch_reverted" /
// "vouch_flagged" (-> giver), "vouch_revised" (-> receiver),
// "connection_added" (-> the side that didn't press the button).
model ActivityEvent {
  id         String   @id @default(cuid())
  businessId String
  business   Business @relation("ActivityEventOwner", fields: [businessId], references: [id])

  actorBusinessId String?
  actorBusiness   Business? @relation("ActivityEventActor", fields: [actorBusinessId], references: [id])

  type      String
  createdAt DateTime @default(now())

  // Null until the owner has seen the feed. Nullable rather than a boolean
  // so "when did they see it" is answerable later (a digest needs to know
  // what's still unseen since the last send) without a second migration.
  readAt DateTime?

  // Matches the dashboard feed's `where businessId ... orderBy createdAt desc`.
  @@index([businessId, createdAt])
  // Serves the unread count, which the sidebar asks for on every /app page
  // load — `where businessId ... AND readAt IS NULL`. Separate from the feed
  // index above because that one leads with createdAt as its second column
  // and can't answer a readAt predicate without scanning the business's rows.
  @@index([businessId, readAt])
}

// The network feed: what the whole membership can see happening, as opposed
// to ActivityEvent above, which is one business's private notification inbox.
//
// Two tables rather than one, and the difference is the audience. An
// ActivityEvent has a RECIPIENT (businessId) and is fanned out per person, is
// capped at 50 a head, and carries a read flag. A NetworkEvent has no
// recipient at all — it is written once and read by everyone — so it needs
// none of those three things. Adding a `public` boolean to ActivityEvent
// instead would have made every fan-out write decide a visibility question it
// has no business answering, and would have put the 50-row prune in front of
// a feed that must not lose history.
//
// WHY THIS EXISTS AT ALL, given "derived, never a column": because two of the
// four types cannot be derived. Business.verificationLevel is current state
// with no history anywhere, so "claimed their listing" and "became
// SSM-Verified" have no timestamp to read. The rule this schema states is
// that SUMMARIES (vouchCount, follower counts) are never stored because they
// drift from the rows they summarise. This table stores no counts and no
// copies of text — it records that a thing happened at a time, which
// summarises nothing. Same category as Ask.expiresAt.
// "Tell me when this business gets claimed, or verified, or loses it."
//
// The feature routes/follows.js already named as the better version of
// following an unclaimed listing: "'Tell me when this gets claimed' is a
// better feature and the reason to revisit that line." This is it.
//
// A WATCH IS NOT A FOLLOW, and the two must not be merged. A follow is about
// a relationship — you want to see what they do — and is refused for an
// unclaimed listing because there is nobody there to watch. A watch is about
// a FACT changing, and an unclaimed listing is the most useful thing to point
// it at: the whole point is being told the moment somebody claims it.
//
// Like a follow, it is UNANNOUNCED and one-way. The watched business is never
// told, cannot see its watchers, and there is no count anywhere. The reasoning
// is the one in the Follow model: both reads come off the same index, and only
// one of them is reversible once a number is on a page.
model BusinessWatch {
  id String @id @default(cuid())

  watcherId String
  watcher   Business @relation("WatchWatcher", fields: [watcherId], references: [id])

  watchedId String
  watched   Business @relation("WatchTarget", fields: [watchedId], references: [id])

  // What the level was when the watch was set, so the notifier can say what
  // CHANGED rather than only what it is now. "Meridian is now SSM-Verified"
  // is a different message from "Meridian is no longer SSM-Verified", and
  // without this the watcher would have to be told the same sentence for both.
  //
  // Rewritten each time the watcher is notified, so a business that moves
  // twice produces two accurate messages rather than one and then a wrong one.
  lastSeenLevel String

  createdAt DateTime @default(now())

  // One watch per pair. Watching twice is the same state as watching once,
  // so POST is idempotent against this rather than erroring.
  @@unique([watcherId, watchedId])
  // The notifier's read: everyone watching the business that just changed.
  @@index([watchedId])
}

// One member's record of a business they checked, and when.
//
// THE DIRECTION IS THE WHOLE DESIGN. This table can answer "what have I
// checked?" and must never be able to answer "who has been checking me?".
// The second question is the one that makes a trust directory into
// surveillance: a business that could see it was being investigated would
// learn something about a counterparty's private diligence, and members would
// stop checking.
//
// Enforced the way listFollowers enforces the same rule — every read is keyed
// off the SESSION, never off a business id in a path. There is no route that
// takes a targetId, and adding one would undo this model.
//
// WRITTEN ONLY FOR MEMBERS WHO CAN READ IT BACK (Pro). Logging a Free
// member's lookups to sell them the history later would be collecting data to
// create a need for it; the honest version is that history starts when you
// start paying for it, and is empty before that.
model BusinessCheck {
  id String @id @default(cuid())

  checkedById String
  checkedBy   Business @relation("CheckBy", fields: [checkedById], references: [id])

  checkedId String
  checked   Business @relation("CheckTarget", fields: [checkedId], references: [id])

  // What the business's verification level was AT THE TIME. The point of a
  // check history is that it is a record of what you were told when you made
  // a decision — a log that re-read the level live would rewrite history
  // every time the business changed, which is exactly the property that makes
  // it worthless as a compliance record.
  levelAtCheck String

  createdAt DateTime @default(now())

  // The member's own history, newest first.
  @@index([checkedById, createdAt])
  // Dedupe: checking the same business twice in a day updates the existing
  // row rather than filling the log with one member's repeated typing.
  //
  // NOTE there is no [checkedId, ...] index and there should never be one.
  // This table is queried by checker only. "Who checked me" lives in
  // ProfileView, which is written on a different rule — an index here would
  // be the first step toward answering it from the wrong table.
  @@index([checkedById, checkedId])
}

// Who opened whose profile — the inbound half of GET /businesses/:id.
//
// THIS MODEL IS READ FROM THE TARGET'S SIDE, which every other looking-at-you
// relation in this schema refuses to allow. BusinessCheck says a route that
// answered "who has been checking me?" would expose a counterparty's
// diligence, and lib/businessCheck.js calls that the thing that turns a trust
// directory into surveillance. That reasoning was not wrong and is not
// retracted — the product owner weighed it against the feature and chose the
// feature (Sep 2026). What follows is the shape that concedes the least.
//
// SEPARATE FROM BusinessCheck ON PURPOSE, though both are written by the same
// request. They are different records with different owners:
//
//   BusinessCheck belongs to the VIEWER. It is their diligence log, it stores
//     levelAtCheck because it is evidence of what they were told when they
//     decided, and lib/businessCheck.js is explicit that it is collected only
//     for members who can read it back — so a Free member's browsing is never
//     banked against a future upgrade.
//
//   ProfileView belongs to the VIEWED. It has to be written for EVERY signed-in
//     viewer regardless of their plan, or the count is not a count: gate the
//     write on the viewer's tier and "12 businesses viewed you" would silently
//     mean "12 Pro businesses viewed you", understating it by however many
//     Free members looked.
//
// Merging them would force one of those two rules to give way. Keeping them
// apart costs one extra row per profile open and keeps BusinessCheck's
// promise literally true.
//
// ONE ROW PER PAIR, not per view. A viewer who opens the same profile daily is
// one entry whose count and timestamp move, which is both what the screen
// wants to show (a list of businesses, not a list of events) and what keeps
// this table from growing without bound on the highest-traffic route in the
// app.
model ProfileView {
  id String @id @default(cuid())

  // The business whose profile was opened — the one who gets to read this row.
  viewedId String
  viewed   Business @relation("ProfileViewTarget", fields: [viewedId], references: [id])

  // The business doing the looking. Always a claimed business: an anonymous
  // visitor has no id to record and is counted nowhere, which is stated here
  // because "nobody viewed you" and "only strangers viewed you" look identical
  // on the screen and only this line distinguishes them.
  viewerId String
  viewer   Business @relation("ProfileViewer", fields: [viewerId], references: [id])

  // Written from the viewer's Business.privateBrowsing AT THE TIME OF THE VIEW.
  //
  // THE ROW IS STILL WRITTEN AND STILL COUNTED. Skipping the write for a
  // private viewer would understate every count in the product — the viewed
  // business would be told "3 businesses viewed you" when the true answer was
  // five, which is worse than telling them two of the five were anonymous.
  // What this flag removes is the NAME, in listViewers; viewerSummary does not
  // look at it.
  //
  // CARRIES THE MODE OF THE LATEST VIEW, because there is one row per pair and
  // it is upserted. A member who browses publicly in March and privately in
  // April is anonymous on that row from April onward — their earlier named
  // visit is not preserved separately. That direction is the safe one: turning
  // the setting on hides you going forward AND withdraws the name from a list
  // you are still visiting. The reverse (private, then public) reveals you,
  // which is what choosing to browse publicly means.
  anonymous Boolean @default(false)

  // Total opens by this viewer, all time. Distinct viewers is the row count;
  // total views is the sum of this. The screen shows the first and the second
  // is what makes "viewed you 4 times" possible without an event table.
  viewCount Int @default(1)

  // First and most recent open. lastViewedAt is what every read orders and
  // windows on — firstViewedAt exists so "they have been watching you since
  // March" stays answerable after the count has been rolled up.
  firstViewedAt DateTime @default(now())
  lastViewedAt  DateTime @default(now())

  // One row per (viewed, viewer) pair — the upsert target.
  @@unique([viewedId, viewerId])
  // The only read this model has: my viewers, newest first, windowed.
  @@index([viewedId, lastViewedAt])
}

// Two businesses saying they worked together, on a date, on something.
//
// THE CHEAP RUNG BELOW A VOUCH, and that is the entire design goal. Ranked by
// what a signal costs to fake, this product had the registry rung (SSM -> L2)
// and the reputation rung (a vouch, which costs the giver prose and their own
// name) with nothing in between — so the FIRST artifact it ever asked anyone
// for was the most expensive one. That is why the vouch graph is thin. An
// engagement costs one tap and a month.
//
// IT NEEDS THE OTHER SIDE'S AGREEMENT, for the reason Connection's own comment
// gives about unilateral edges: "a CLAIM ABOUT A RELATIONSHIP... in a directory
// built to make trust legible [a unilateral one] is a forgeable signal". The
// asks board already demonstrates what happens without that check — 3 of its 4
// accepted answers are self-nominations, which is one party talking about
// itself.
//
// COLLUSION IS POSSIBLE AND ACCEPTED. Two businesses can confirm work that
// never happened. That costs them a colluder, which is strictly more than a
// self-nomination costs today, and the mitigation is visibility rather than
// prevention: reads report DISTINCT COUNTERPARTIES, never a row count, so ten
// engagements with one friend reads as one counterparty. See
// engagementSummaryFor in lib/engagements.js — a ring is obvious when you can
// see who, and invisible behind a single number.
//
// NOT A RATING. There is no score, stars or free-form testimonial here. A
// vouch is the place to say someone is good; this only says you worked
// together. Keeping it factual is what keeps it cheap enough to be created,
// and what keeps it defensible — a dated fact survives a dispute in a way a
// judgement does not.
model Engagement {
  id String @id @default(cuid())

  // "pending"   — the counterparty's move
  // "confirmed" — both agree. Terminal, and the ONLY status anyone else sees.
  // "declined"  — the counterparty says it did not happen. Terminal, and
  //               PRIVATE: only the proposer is told, it is shown to nobody
  //               and counted nowhere. If declines were public, proposing
  //               engagements a rival would obviously decline becomes a way to
  //               damage them, which is a weapon rather than a record.
  // "cancelled" — withdrawn by the proposer, or lapsed after 14 days untouched
  //               (lib/engagements.js, the same lazy sweep vouches use).
  status String @default("pending")

  // The pair, ordered by id via orderedPair in lib/connections.js so one row
  // serves both directions — the same storage Connection uses.
  businessAId String
  businessA   Business @relation("EngagementA", fields: [businessAId], references: [id])

  businessBId String
  businessB   Business @relation("EngagementB", fields: [businessBId], references: [id])

  // Which end proposed. Not derivable from the ordered pair, and it decides
  // who may confirm (the other one) and who may withdraw (this one). Same role
  // and same reasoning as Connection.requestedById.
  proposedById String
  proposedBy   Business @relation("EngagementProposer", fields: [proposedById], references: [id])

  // A canonical service from lib/serviceVocab.js, validated on write.
  //
  // THIS IS WHAT MAKES ENGAGEMENTS AGGREGATE. Because it is a catalogue value
  // rather than typed text, "4 confirmed for SST advisory, from 3 different
  // businesses" is answerable — and a profile can separate the services a
  // business CLAIMS from the ones a counterparty has confirmed. Today anyone
  // can tick all twelve services in their category and nothing checks it.
  //
  // Nullable: work that maps to no catalogue entry is still real work. Such a
  // row is shown but never appears in a per-service aggregate, exactly the
  // contract a custom service has on a profile.
  service String?

  // Free text, optional, and deliberately inert — never matched, never
  // aggregated, never searched. It exists so a reader can tell two engagements
  // for the same service apart.
  note String?

  // When the WORK happened, not when the row was written. Stored as the first
  // of the month because that is the precision anyone can honestly remember,
  // and a false day-level precision would invite disputes about the day.
  occurredOn DateTime

  // Optional provenance: the ask this came out of. Closes the asks ->
  // track-record loop without making asks load-bearing for trust, and stays
  // null for the engagements that began over lunch.
  askId String?
  ask   Ask?    @relation(fields: [askId], references: [id])

  createdAt    DateTime  @default(now())
  // Bumped on every transition; drives the 14-day lazy expiry.
  lastActionAt DateTime  @default(now())
  confirmedAt  DateTime?

  // NO @@unique ON THE PAIR — the one deliberate difference from Connection,
  // which allows exactly one edge per pair. Working together repeatedly is the
  // strongest thing this model can record, so each engagement is its own row.
  @@index([businessAId, status])
  @@index([businessBId, status])
  @@index([proposedById])
}

model NetworkEvent {
  id String @id @default(cuid())

  // "vouch_published"          — a testimonial went live on a profile
  // "recommendation_published" — an asker accepted somebody else's answer
  // "business_claimed"         — an L0 listing became a member (L0 -> L1)
  // "business_verified"        — SSM verification granted (L1 -> L2)
  //
  // String, not a Prisma enum — this schema has none. NETWORK_EVENT_TYPES in
  // lib/networkEvents.js is the only thing constraining it.
  //
  // "vouch_published" deliberately shares a name with the ActivityEvent type:
  // it is the same real-world event written for two different audiences, and
  // giving the network copy a second name would hide that.
  type String

  // Who the event is ABOUT. Always set — the vouch's receiver, the recommended
  // business, the business that claimed or got verified.
  subjectBusinessId String
  subjectBusiness   Business @relation("NetworkEventSubject", fields: [subjectBusinessId], references: [id])

  // Who DID it. Null when nobody did: a claim approval and an SSM verification
  // are an admin's move, and naming an admin account here would put staff into
  // a members' feed. Same call ActivityEvent makes with actorBusinessId on
  // ask_expired.
  actorBusinessId String?
  actorBusiness   Business? @relation("NetworkEventActor", fields: [actorBusinessId], references: [id])

  // POINTERS, never copies — exactly the shape Vouch.currentRevisionId uses,
  // and for the same reason its comment gives: a denormalized copy of the
  // testimonial is where history goes to die. The feed joins through these for
  // the text, so an edited or withdrawn one changes here with no second write.
  //
  // Exactly one is set on the two content types; both are null on the two
  // level types. Nullable rather than a polymorphic subjectId + subjectType
  // pair, which would be two columns that can disagree about what they point
  // at, with no foreign key on either.
  //
  // Cascade on delete, unlike every Business key in this schema. A pointer has
  // nothing to unwind: delete the vouch or the answer and the announcement is
  // about something that no longer exists. It is also required rather than
  // merely tidy — routes/asks.js deletes an AskAnswer outright as the
  // compensating step when one loses the maxAnswers race, and a RESTRICT here
  // would let the feed wedge that path.
  vouchId     String?
  vouch       Vouch?     @relation(fields: [vouchId], references: [id], onDelete: Cascade)
  askAnswerId String?
  askAnswer   AskAnswer? @relation(fields: [askAnswerId], references: [id], onDelete: Cascade)

  // The level REACHED, for the two level types. Stored because it is a fact
  // about the PAST, and Business.verificationLevel can no longer answer it
  // once the level moves again. It is also what makes the event self-revoking:
  // the feed requires the subject to still BE at this level, so a revoked SSM
  // verification drops its own announcement out of the feed with no
  // compensating write. Values from lib/verificationLevels.js.
  toVerificationLevel String?

  createdAt DateTime @default(now())

  // The feed's only ordering. Paired with id in the ORDER BY so the cursor is
  // total — two events written inside the same millisecond (a claim approval
  // writes one while publishing held recommendations writes others) would
  // otherwise be able to swap places between two pages and hand the reader a
  // duplicate.
  @@index([createdAt, id])
  // Both ends of the "Following" scope, which filters on actor OR subject.
  // Also FK hygiene, the reason Connection carries @@index([requestedById]):
  // Postgres does not index a foreign key for you, and the RESTRICT check on
  // a Business delete is otherwise a sequential scan.
  @@index([actorBusinessId])
  @@index([subjectBusinessId])
  // Serves the backfill's idempotence check and nothing else on the hot path.
  @@index([vouchId])
  @@index([askAnswerId])
}

// A mutual edge — connecting via a tap (or in-app connect) links both
// sides, so it's stored once per pair rather than as two directed rows.
// The app layer must always store the lexicographically smaller business
// id as businessAId so the unique constraint actually catches duplicates
// regardless of which side scanned which card (mirrors connectionId() in
// the mock's connections.js).
model Connection {
  id        String   @id @default(cuid())
  // "nfc_scan" | "directory"
  source    String
  createdAt DateTime @default(now())

  // "pending" | "accepted". A connection is a CLAIM ABOUT A RELATIONSHIP,
  // so it needs the other side's agreement — until Aug 2026 anyone could
  // press Connect and appear in a stranger's network unilaterally, which in
  // a directory built to make trust legible is a forgeable signal. It only
  // hadn't bitten because connections are private to each side's own screen;
  // "Suggested matches" would have routed real work through invented edges.
  //
  // A card tap is the deliberate exception and is written straight to
  // "accepted": a physical tap is proof the two were in the same room, which
  // is exactly the evidence an approval step exists to collect. That is what
  // `source` is for, and the one place it changes behaviour rather than just
  // recording history.
  //
  // Follow (below) is the one-way alternative for "I want to watch this
  // business" — the thing this model deliberately no longer is.
  status String @default("accepted")

  // Which end asked. Not derivable from the A/B columns: those are ordered
  // lexicographically by id (see orderedPair in lib/connections.js) so that
  // one row can serve both directions, which throws away who moved first.
  // Only meaningful while status is "pending" — it decides who may accept
  // (the other one) and who may withdraw (this one).
  //
  // Backfilled to businessAId for rows that predate the column. Those are
  // all "accepted", where the field is never read, so an arbitrary but
  // non-null value is honest: nobody recorded who asked, and inventing a
  // nullable column to say so would add a branch to every read forever.
  requestedById String
  requestedBy   Business @relation("ConnectionRequester", fields: [requestedById], references: [id])

  respondedAt DateTime?

  businessAId String
  businessA   Business @relation("ConnectionA", fields: [businessAId], references: [id])

  businessBId String
  businessB   Business @relation("ConnectionB", fields: [businessBId], references: [id])

  @@unique([businessAId, businessBId])
  // FK hygiene, same reason as businessBId below. Nothing queries `status`,
  // so it gets no index — see the migration for why.
  @@index([requestedById])
  // The only read this table gets is "every edge touching me", i.e.
  // `OR: [{ businessAId }, { businessBId }]`. The unique above already
  // indexes the businessAId side; without this one Postgres can't turn the
  // other half into an index scan and has to fall back to a seq scan for
  // the whole OR rather than a BitmapOr of two.
  @@index([businessBId])
}

// One business watching another. Deliberately NOT a weaker Connection:
//
//   Connection — mutual, the other side accepted, both parties see it. Says
//                "we have actually dealt with each other", and is what later
//                features (matching, introductions) are allowed to trust.
//   Follow     — one-way, no approval, and INVISIBLE to the business being
//                followed. Says "I am keeping an eye on this", which is a
//                statement about the follower and nobody else.
//
// Unannounced, which is not quite the same as invisible, and the difference
// is where the line now sits. Nothing here notifies the followed business and
// no activity event is written — it is never TOLD, and never told who
// stopped. But since Aug 2026 it can go and look: a business may read its own
// follower list (listFollowers in lib/follows.js, the Followers tab).
//
// What stays off the table is a follower COUNT, anywhere, on any profile.
// That is the half that can't be taken back: a number on a page gets
// solicited, farmed and compared, and following stops being a private signal
// about the follower and becomes a public score for the followed. Both reads
// are one query against @@index([followedId]) below; only one of them is
// reversible. Don't add the count casually.
//
// Uncapped on every plan, Free included, and that is deliberate: Free needs
// something genuinely useful to do, and a private list costs nobody anything.
// The cap that matters is on connection REQUESTS, which are addressed to a
// person.
//
// Independent of Connection: you may follow a business you are connected to
// and vice versa. Collapsing them would mean disconnecting silently dropped
// a watchlist entry the member never asked to lose.
model Follow {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  followerId String
  follower   Business @relation("FollowFrom", fields: [followerId], references: [id])

  followedId String
  followed   Business @relation("FollowTo", fields: [followedId], references: [id])

  @@unique([followerId, followedId])
  // Serves two things now: the FK's delete path on Business, and the
  // follower-list read a business runs against its own id. Never a count on
  // somebody else's profile — see above.
  @@index([followedId])
}

// Bridges "scanned a card while logged out" and "account actually exists
// with a session" — a manual-review claim can take days to approve, so the
// intent to connect is queued here and consumed the moment that account's
// first session starts (see startSession in lib/session.js, which is the
// only consumer).
//
// A row here is a transient to-do, never a record worth keeping: it exists
// only until the connection it describes is made. That's why accountId
// cascades rather than restricting. Several paths delete an Account —
// losing a contested claim (approveClaimAndRejectRivals), being rejected
// by an admin (routes/admin.js), having an approved claim revoked — and
// under RESTRICT every one of them would have to remember to clear this
// table first or the delete fails with a foreign-key error that surfaces
// as a generic 500. There is no case where a queued connect intent should
// outlive the account that queued it, so the database enforces that rather
// than each call site remembering to.
// Renamed from PendingConnection in Aug 2026, when Connection gained a
// "pending" status of its own. Two different things called pending in one
// domain is how a reader ends up looking for a queued card tap in the
// connection-requests inbox: this one is not a request anybody can see or
// answer, it is an intent parked until the account exists.
model DeferredConnection {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  accountId String
  account   Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  businessId String
  business   Business @relation(fields: [businessId], references: [id])

  @@unique([accountId, businessId])
}

// Stands in for "an email was sent." Two shapes depending on where in the
// claim lifecycle it's minted (see emailVerifications.js):
//  - claimPayload set, accountId null: domain-match path — nothing exists
//    yet; consuming the token is what creates the account/business.
//  - accountId set, claimPayload null: manual-review path — account/
//    business already exist and are already approved; consuming the token
//    just finalizes email verification and starts a session.
model EmailVerificationToken {
  token        String   @id @default(cuid())
  email        String
  businessId   String?
  accountId    String?
  claimPayload Json?
  consumed     Boolean  @default(false)
  createdAt    DateTime @default(now())
  expiresAt    DateTime
}

// A demand-only post: one business states a requirement, other businesses
// answer it by naming somebody who can meet it.
//
// Demand only, and that is the design rather than a first cut. An "offer"
// post is cheap to write (it is an advertisement) and an ask is expensive
// (it admits a need), so on one board offers outnumber asks within weeks and
// the asks stop being findable. Partnership and Collaboration are two of the
// seven CATEGORIES below, which is what keeps "let's work together" on this
// board without opening it to broadcast. Offers already have a home: the
// business's own profile and services[].
//
// Three anti-spam mechanisms, and none of them is a paywall or admin work:
//   1. T2 to post   — ASK_POSTING_TIERS in lib/asks.js. Verification cannot
//                     be bought (ABRI-feature-checklist.md §6), so this is
//                     the one gate money can't open, and it makes the board
//                     a reason to get verified rather than a reason to pay.
//   2. maxAnswers   — a cap on the ANSWER side, not the ask side. Nextdoor
//                     and Alignable don't cap asks; LinkedIn caps proposals
//                     at 5; Thumbtack charges pros per response. Everyone
//                     constrains the answering end, because on a demand
//                     board demand is the scarce thing and supply is what
//                     arrives as spam.
//   3. one answer per business per ask — the @@unique on AskAnswer.
// There is deliberately NO cap on how many asks a business may post. The
// brakes are T2 being revocable (POST /admin/businesses/:id/revoke-ssm) and
// the 30-day expiry below, not a number in this file.
model Ask {
  id String @id @default(cuid())

  askedByBusinessId String
  askedByBusiness   Business @relation("AskAuthor", fields: [askedByBusinessId], references: [id])

  // "Customer requirement" | "Supplier requirement" | "Partnership" |
  // "Distribution" | "Export" | "Service requirement" | "Collaboration"
  // — ABRI-feature-checklist.md §7, which says of itself "this is the only
  // copy". String rather than an enum because this schema has no Prisma
  // enums anywhere; the set is enforced in exactly one JS module
  // (ASK_CATEGORIES in lib/asks.js), the same way CONNECTION_SOURCES
  // constrains Connection.source.
  category String

  // The ROUTING keys, and the reason this board works at 22 businesses where
  // a scrolling feed would not: an ask is not broadcast, it is addressed to
  // a kind of business in a place, and reaches them as a work prompt on
  // their dashboard.
  //
  // Deliberately drawn from the SAME closed vocabularies as Business
  // .category and Business.location (lib/businessVocab.js) rather than new
  // ones — routing is an equality join against those two columns, and a
  // second vocabulary would need mapping onto the first at every read.
  //
  // §7's "Looking for" / "Can offer" tag lists are NOT built. When they are,
  // they arrive as their own String[] columns beside these two and a widened
  // matchTierFor — no migration of anything already written here.
  matchCategory String
  matchLocation String

  // The THIRD routing key, and the one §7 above predicted: "they arrive as
  // their own String[] columns beside these two and a widened matchTierFor —
  // no migration of anything already written here." This is that column, and
  // that promise held: every existing ask has [] and behaves exactly as it did.
  //
  // CANONICAL SERVICES ONLY, validated on write against lib/serviceVocab.js.
  // A custom service a business typed is deliberately unmatchable — see that
  // file — so letting one in here would create an ask nothing can ever match,
  // which is the silent miss this whole mechanism exists to remove.
  //
  // EMPTY MEANS "ANYONE IN THIS TRADE", not "nobody". An asker who does not
  // know which service they need should not have to guess one, and the board
  // still routes them by category and location exactly as before.
  matchServices String[] @default([])

  // One line, shown everywhere. `detail` is the body and is optional: an ask
  // reading "Looking for a corporate secretary in KL" is already complete,
  // and requiring a paragraph is how a board fills up with padding.
  title  String
  detail String?

  // "open"         — accepting answers, subject to maxAnswers; the asker may
  //                  accept one
  // "answered"     — the asker accepted an answer. Terminal.
  // "closed"       — terminal with no accepted answer: the asker closed it
  //                  early, or 30 days lapsed (see lib/askExpiry.js)
  // "under_review" — frozen by a flag; an admin's move, and the one status
  //                  the expiry doesn't touch — same reasoning as
  //                  under_review on a Vouch: the parties can't clear the
  //                  admin's queue, so they shouldn't be timed out by it.
  status String @default("open")

  // How many answers this ask takes before it stops accepting them.
  // Per-row rather than a global constant, for the same reason
  // Vouch.maxRevisions is: a specific ask can be widened later without a
  // migration, and the client reads the cap off the ask instead of keeping a
  // constant that can drift from the server's.
  //
  // NULL MEANS NO CAP, and null is now the default.
  //
  // It was 6, reasoned as "at current density a category holds five or six
  // businesses, so the cap binds on VOLUME and never on eligibility". That
  // reasoning was self-defeating in both directions: while it never binds it
  // does nothing, and the moment it does bind it locks out the SEVENTH
  // business to answer — which selects on speed, not on fit. A board that
  // rewards refreshing fastest is the marketplace §6 rules out.
  //
  // Kept as a nullable column rather than deleted, because the clutter problem
  // it was aimed at is real: an asker does have to read every answer. The fix
  // is that the limit is now the ASKER'S to set, on an ask where they want
  // one, instead of a global default applied to askers who never asked for it.
  maxAnswers Int?

  // The deadline, stored rather than derived from createdAt + a constant.
  // Three reasons: the lazy check is a comparison rather than arithmetic;
  // the UI can render "closes in 12 days" without a second copy of the 30 in
  // the client; and an admin returning a frozen ask to "open" RESTARTS it
  // here, so the parties don't lose the days they spent in a queue they
  // couldn't clear. That last one is what rules out reading createdAt.
  //
  // Not a derived count. The rule this schema states is that vouchCount,
  // vouchLevel and follower counts are never columns because they can drift from
  // the rows they summarise; a per-row deadline summarises nothing.
  expiresAt DateTime
  createdAt DateTime  @default(now())
  // Set when the ask reaches "answered" or "closed". Distinguishes settled
  // from in-flight without enumerating status values — same job closedAt
  // does on Vouch.
  closedAt  DateTime?

  answers     AskAnswer[]
  flags       AskFlag[]
  // Engagements that name this ask as where the work came from.
  engagements Engagement[]

  // FK hygiene, the reason Connection carries @@index([requestedById]):
  // Postgres does not index a foreign key for you, and the RESTRICT check on
  // a Business delete is otherwise a sequential scan. Doubles as GET
  // /asks/mine.
  @@index([askedByBusinessId])
  // The routing read (open asks in my category) and the board's default
  // filter, in one index. The only composite here worth its write cost.
  //
  // Deliberately NO index on expiresAt: nothing queries by it. The expiry is
  // lazy and reads the column off rows already loaded, exactly as
  // lib/vouchExpiry.js reads Vouch.lastActionAt, which is likewise unindexed.
  @@index([status, matchCategory])
}

// One business's answer to one ask, and the model that carries the whole
// anti-self-promotion mechanism — in two columns rather than a flag:
//
//   answeredByBusinessId  — who wrote it
//   recommendedBusinessId — who they named
//
// Self-nomination is exactly `recommendedBusinessId == answeredByBusinessId`.
// It is ALLOWED and it is LABELLED DIFFERENTLY: "recommended X" and "offered
// their own services" are separate strings in the UI, separate activity event
// types (ask_answered vs ask_self_offered), and only the first counts toward
// a give-first statistic or produces a public Recommendation. Blocking
// self-nomination outright would be absurd in a cluster this size — if
// somebody needs an accountant and you are the accountant, you should be able
// to say so. Labelling it is what keeps that honest.
//
// There is deliberately no `kind` column saying which it is. A third column
// restating what two foreign keys already say is a denormalization that can
// disagree with them, and the disagreeing case — a row marked
// "recommendation" whose two ids are equal — is precisely the one that would
// let self-promotion out onto somebody else's profile.
model AskAnswer {
  id    String @id @default(cuid())
  askId String
  ask   Ask    @relation(fields: [askId], references: [id])

  answeredByBusinessId String
  answeredByBusiness   Business @relation("AskAnswerAuthor", fields: [answeredByBusinessId], references: [id])

  // Must be a real Business row, never free text: the payoff of an accepted
  // answer is a Recommendation on a profile, and a profile is something only
  // a Business has — an off-directory name would be an unverifiable string
  // in a product whose whole claim is that its names are checked.
  //
  // MAY be T0, and this is the one place the board departs from "an
  // unclaimed listing is refused every relational action" (POST /connections,
  // POST /follows). Two reasons it is different here: an answer is addressed
  // to the ASKER, not to the business named, so recommending an unclaimed
  // listing does nothing TO an absent owner; and once the corridor SSM import
  // lands, the most useful answer will routinely be a business that hasn't
  // claimed yet, so refusing would make most real answers illegal.
  //
  // It needs no "held" or "published" column. BusinessProfile.jsx wraps the
  // whole tab block in {!isUnclaimed && ...}, so a T0 profile has no
  // Recommendations tab to render into — the recommendation is simply
  // invisible until the claim flips the business to T1, at which point it is
  // already there. Publication is derived: recommendedBusiness.verificationLevel != "L0".
  recommendedBusinessId String
  recommendedBusiness   Business @relation("AskAnswerRecommended", fields: [recommendedBusinessId], references: [id])

  // Required. An answer that names a business and says nothing about why is
  // a name-drop, and a board of name-drops is what the directory already is.
  comment String

  // "offered"      — live, in front of the asker
  // "accepted"     — the asker picked it. The ONLY status that publishes
  //                  anything (see the Recommendations tab).
  // "withdrawn"    — the answerer took it back. Terminal, but the row is
  //                  reusable: a fresh answer on the same ask resets THIS row
  //                  in place rather than deleting and recreating, exactly as
  //                  a cancelled Vouch is reused, which is what keeps the
  //                  @@unique below meaning "one answer per business per ask,
  //                  ever".
  // "under_review" — frozen by a flag; an admin's move
  // "removed"      — an admin killed it. Terminal AND NOT reusable — see
  //                  ANSWER_CAP_STATUSES in lib/asks.js. The asymmetry with
  //                  "withdrawn" is deliberate: withdrawing frees your slot
  //                  back to you, being removed frees it to everybody else.
  status String @default("offered")

  createdAt  DateTime  @default(now())
  acceptedAt DateTime?

  flags         AskFlag[]
  // Back-relation only — see the note on Vouch.networkEvents.
  networkEvents NetworkEvent[]

  // The anti-piling-on rule, enforced by the database rather than by a check
  // every caller has to remember. Note what it does NOT constrain: two
  // different businesses recommending the SAME business on one ask is left
  // legal, because two independent recommendations are a signal, not spam.
  @@unique([askId, answeredByBusinessId])
  // The Recommendations tab: where recommendedBusinessId = X, status =
  // "accepted". A lookup by a column that leads no other index, so this one
  // earns its place — and it is FK hygiene at the same time.
  @@index([recommendedBusinessId, status])
  // FK hygiene, plus GET /asks/answered. askId needs no index of its own:
  // the @@unique above already leads with it.
  @@index([answeredByBusinessId])
}

// A report an admin is meant to read.
//
// A separate table from VouchFlag rather than a generalisation of it, and
// that is a considered call: making VouchFlag.vouchId nullable would break
// the one thing that model asserts (every row is about a vouch), leave
// @@index([vouchId]) half empty, and make the queue's "anything still frozen"
// clause branch on which target column is set. Two tables of the same shape
// is cheaper honesty than one table with a hole in it. If a THIRD flaggable
// thing ever appears, that is the moment to generalise.
//
// One table for both targets here, though, because they share a queue and a
// verdict. askId is ALWAYS set, including on an answer report, so the queue
// can show the ask a reported answer sits under in one join; answerId null
// means the report is about the ask itself.
model AskFlag {
  id    String @id @default(cuid())
  askId String
  ask   Ask    @relation(fields: [askId], references: [id])

  // Null => the report is about the ask. Set => about that answer.
  answerId String?
  answer   AskAnswer? @relation(fields: [answerId], references: [id])

  raisedByBusinessId String
  raisedByBusiness   Business @relation("AskFlagRaisedBy", fields: [raisedByBusinessId], references: [id])

  // Derived at the route, never taken from the body: the asker for an ask
  // report, the ANSWERER for an answer report. Never the recommended
  // business — they did nothing.
  againstBusinessId String
  againstBusiness   Business @relation("AskFlagAgainst", fields: [againstBusinessId], references: [id])

  // Against an ask:    "spam" | "not_a_real_ask" | "abusive_content" | "other"
  // Against an answer: "self_promotion" | "irrelevant" | "abusive_content" | "other"
  // Enforced by ASK_FLAG_REASONS / ANSWER_FLAG_REASONS in lib/asks.js.
  reason String
  note   String?

  // Separate status and outcome, for the reason VouchFlag states: "an admin
  // looked at this" and "an admin agreed with it" are different facts, and
  // only the second is worth counting. This is the column that makes a
  // repeat frivolous reporter visible, which is the only real defence
  // against flag-griefing on a board anyone can report on.
  status              String    @default("open") // "open" | "reviewed"
  outcome             String? // "upheld" | "dismissed"
  resolvedAt          DateTime?
  resolvedByAccountId String?
  resolvedByAccount   Account?  @relation("AskFlagResolver", fields: [resolvedByAccountId], references: [id])
  createdAt           DateTime  @default(now())

  // Matches VouchFlag's single index, and for the same reason: every read of
  // this table is "the reports on this ask". There is deliberately no unique
  // constraint expressing "one report per business per target" — Postgres
  // treats NULLs as distinct, so a unique on (askId, answerId,
  // raisedByBusinessId) would not stop two ask-level reports from the same
  // business. The dedupe is a findFirst in the route.
  @@index([askId])
}
