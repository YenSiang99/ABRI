# Local Postgres 16 — see README.md for starting it via Homebrew or Docker.
#
# Both URLs are the same string: Prisma wants a pooled one for the app and a
# direct one for `prisma migrate` (DDL needs a non-pooled connection), and
# there's no PgBouncer in front of a local container. The EC2 host is set up the
# same way — see /etc/abri/prod.env there.
DATABASE_URL="postgresql://abri:abri@localhost:5432/abri"
DIRECT_URL="postgresql://abri:abri@localhost:5432/abri"

PORT=4000

# Signs auth session cookies — keep this secret, never commit it. Generate
# with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET="replace-with-a-random-value"

# Vite's default dev port — needed so the backend's CORS config trusts
# cookies from the frontend's origin.
FRONTEND_URL="http://localhost:5173"

# From resend.com dashboard → API Keys. Verification emails (claim
# approval, domain-match auto-claim, self-register) are skipped with a
# console warning if this is unset — see lib/mailer.js.
RESEND_API_KEY="re_replace_with_a_real_key"

# Must be a verified domain's address, e.g. "ABRI <noreply@yourdomain.com>".
# Left unset, mailer.js falls back to Resend's shared sandbox address,
# which can only actually deliver to the email on the Resend account that
# owns RESEND_API_KEY — fine for testing, not for real users.
RESEND_FROM_EMAIL=
