# Local Postgres 16 — see README.md for starting it via Homebrew or Docker.
#
# Both URLs are the same string: Prisma wants a pooled one for the app and a
# direct one for `prisma migrate` (DDL needs a non-pooled connection), and
# there's no PgBouncer in front of a local container. The EC2 host is set up the
# same way — see /etc/abri/prod.env there.
DATABASE_URL="postgresql://abri:abri@localhost:5432/abri"
DIRECT_URL="postgresql://abri:abri@localhost:5432/abri"

PORT=4000

# Signs auth session cookies — keep this secret, never commit it. Generate
# with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET="replace-with-a-random-value"

# Vite's default dev port — needed so the backend's CORS config trusts
# cookies from the frontend's origin.
FRONTEND_URL="http://localhost:5173"

# Outgoing email, over SMTP (lib/mailer.js). Any provider that offers SMTP
# works: Google Workspace (smtp.gmail.com, 587, an app password), Zoho
# (smtp.zoho.com), Amazon SES (email-smtp.<region>.amazonaws.com), …
# Leave SMTP_HOST empty on your own machine: nothing is sent, and the
# confirmation links and claim codes show on screen instead.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="ABRI <hello@abri.asia>"

# Servers run as production builds, which never show links on screen. Set
# this to 1 on dev.abri.asia only, while it has no SMTP, so dev can still be
# tested without real email. Never on prod.
MAIL_SHOW_LINKS=

# The Ask ABRI chat at /ask (routes/ask.js). A free key from
# https://aistudio.google.com/apikey — no card needed. Leave empty and the chat
# is simply hidden. GEMINI_MODEL is optional (default gemini-3.5-flash-lite).
GEMINI_API_KEY=
GEMINI_MODEL=
